PORT=5000
DATABASE_URL="mysql://root@localhost:3306/madrasah_db?connection_limit=30&pool_timeout=30"
JWT_ACCESS_SECRET="ganti_dengan_secret_access_yang_panjang_dan_aman"
JWT_REFRESH_SECRET="ganti_dengan_secret_refresh_yang_panjang_dan_aman"
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
# Gunakan "none" jika frontend dan backend beda domain/subdomain di hosting (dengan HTTPS)
COOKIE_SAMESITE="lax"
GOOGLE_CLIENT_ID="isi_dengan_google_client_id_dari_google_cloud_console"
GOOGLE_CLIENT_SECRET="isi_dengan_google_client_secret_dari_google_cloud_console"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Konfigurasi SMTP Pengiriman Email (Gmail / Hostinger / cPanel / Mailgun)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="alamat-email-madrasah@gmail.com"
SMTP_PASS="app_password_16_digit_dari_google"
SMTP_FROM_NAME="MTs NW Pendem"
SMTP_FROM_EMAIL="alamat-email-madrasah@gmail.com"
